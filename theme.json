{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1170px"
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{
					"name": "10px",
					"size": "10px",
					"slug": "10"
				},
				{
					"name": "20px",
					"size": "20px",
					"slug": "20"
				},
				{
					"name": "30px",
					"size": "30px",
					"slug": "30"
				},
				{
					"name": "50px",
					"size": "50px",
					"slug": "50"
				},
				{
					"name": "60px",
					"size": "60px",
					"slug": "60"
				},
				{
					"name": "70px",
					"size": "70px",
					"slug": "70"
				},
				{
					"name": "100px",
					"size": "100px",
					"slug": "100"
				}
			]
		},
		"position": {
			"sticky": true
		},
		"dimensions": {
			"minHeight": true
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#ff4801"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "#0cbb52"
				},
				{
					"name": "Main BG",
					"slug": "main-bg",
					"color": "#0a0a0a"
				},
				{
					"name": "Light BG",
					"slug": "light-bg",
					"color": "#111111"
				},
				{
					"name": "Dark BG",
					"slug": "dark-bg",
					"color": "#111013"
				},
				{
					"name": "Heading Color",
					"slug": "heading-color",
					"color": "#ffffff"
				},
				{
					"name": "Text White",
					"slug": "text-white",
					"color": "#ffffff"
				},
				{
					"name": "Text Color",
					"slug": "text-color",
					"color": "#999999"
				},
				{
					"name": "Link Color",
					"slug": "link-color",
					"color": "#ffffff"
				},
				{
					"name": "Border",
					"slug": "border",
					"color": "#242424"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontStyle": true,
			"fontWeight": true,
			"lineHeight": true,
			"letterSpacing": true,
			"textTransform": true,
			"textDecoration": true,
			"textAlign": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"name": "Poppins",
					"slug": "poppins",
					"fontFamily": "Poppins, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Poppins",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/Poppins-Regular.woff2" ]
						},
						{
							"fontFamily": "Poppins",
							"fontWeight": "500",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/Poppins-Medium.woff2" ]
						},
						{
							"fontFamily": "Poppins",
							"fontWeight": "600",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/Poppins-SemiBold.woff2" ]
						},
						{
							"fontFamily": "Poppins",
							"fontWeight": "700",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/Poppins-Bold.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "Small Paragraph",
					"slug": "small-paragraph",
					"size": "14px"
				},
				{
					"name": "Medium Paragraph",
					"slug": "medium-paragraph",
					"size": "16px"
				},
				{
					"name": "Large Paragraph",
					"slug": "large-paragraph",
					"size": "18px"
				},
				{
					"name": "Small Title",
					"slug": "small-title",
					"size": "16px"
				},
				{
					"name": "Medium Title",
					"slug": "medium-title",
					"size": "20px"
				},
				{
					"name": "Large Title",
					"slug": "large-title",
					"size": "24px"
				},
				{
					"name": "Heading 01",
					"slug": "heading-01",
					"size": "94px"
				},
				{
					"name": "Heading 02",
					"slug": "heading-02",
					"size": "72px"
				},
				{
					"name": "Heading 03",
					"slug": "heading-03",
					"size": "60px"
				},
				{
					"name": "Heading 04",
					"slug": "heading-04",
					"size": "48px"
				},
				{
					"name": "Heading 05",
					"slug": "heading-05",
					"size": "36px"
				},
				{
					"name": "Heading 06",
					"slug": "heading-06",
					"size": "30px"
				},
				{
					"name": "Button Large",
					"slug": "button-large",
					"size": "16px"
				},
				{
					"name": "Button Small",
					"slug": "button-small",
					"size": "14px"
				}
			]
		}
	},
	"styles": {
		"css": ".artifact-hero{position:relative;overflow:hidden;min-height:762px}.artifact-hero>.wp-block-image.artifact-hero__scene{position:absolute;left:calc(50% - 800px);top:-88px;width:1600px;max-width:none;pointer-events:none}.artifact-hero__scene img{display:block;width:1600px;height:850px;max-width:none}.artifact-hero .alignwide{position:relative;z-index:1}.artifact-button-icon .wp-block-button__link{display:inline-flex;align-items:center;gap:12px;border-radius:12px}.artifact-service-icon{display:flex;align-items:center;justify-content:center;width:64px;height:64px;border-radius:12px;background:var(--wp--preset--color--primary);flex-shrink:0}.artifact-service-icon img{width:32px;height:32px}.artifact-step{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:8px;border:1px solid var(--wp--preset--color--text-white);color:var(--wp--preset--color--text-white);font-weight:700;flex-shrink:0}.artifact-step.is-current{background:var(--wp--preset--color--primary);border-color:var(--wp--preset--color--primary)}.artifact-team-card{border-radius:24px;overflow:hidden}.artifact-team-card img{display:block;width:100%;height:auto;border-radius:24px}.artifact-pagination-dots{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:48px}.artifact-dot{width:14px;height:14px;border-radius:8px;background:var(--wp--preset--color--border);display:inline-block}.artifact-dot.is-active{background:var(--wp--preset--color--primary)}.artifact-blog-thumb{position:relative;border-radius:24px;overflow:hidden}.artifact-blog-thumb img{display:block;width:100%;height:auto;border-radius:24px}.artifact-blog-badge{position:absolute;left:20px;top:20px;background:var(--wp--preset--color--text-white);color:var(--wp--preset--color--dark-bg);font-size:var(--wp--preset--font-size--button-small);font-weight:700;padding:8px 16px;border-radius:174px;line-height:20px}.artifact-blog-link{display:inline-flex;align-items:center;gap:8px;color:var(--wp--preset--color--text-white);text-decoration:none;font-weight:600;font-size:var(--wp--preset--font-size--button-large)}.artifact-blog-link:hover{color:var(--wp--preset--color--primary)}.artifact-cta-box{position:relative;border-radius:24px;overflow:hidden;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:24px}.artifact-cta-title{font-family:var(--wp--preset--font-family--poppins);font-weight:700;font-size:clamp(36px,5vw,64px);line-height:1.15;letter-spacing:-0.03em;color:var(--wp--preset--color--text-white);margin:0;max-width:760px;text-align:center}@media (max-width:781px){.artifact-cta-box{padding:48px 24px !important}}.artifact-footer-pill a{display:inline-flex;align-items:center;gap:8px;padding:16px 32px;border:1px solid var(--wp--preset--color--border);border-radius:12px;color:var(--wp--preset--color--text-white);text-decoration:none;font-size:var(--wp--preset--font-size--small-paragraph)}.artifact-footer-pill a:hover{border-color:var(--wp--preset--color--primary);color:var(--wp--preset--color--primary)}.artifact-footer-newsletter{width:416px;max-width:100%}.artifact-newsletter-form{display:flex;align-items:center;background:var(--wp--preset--color--light-bg);border:1px solid var(--wp--preset--color--border);border-radius:12px;padding:4px 4px 4px 16px;width:100%;max-width:416px;box-sizing:border-box;transition:border-color .2s ease}.artifact-newsletter-form:focus-within{border-color:var(--wp--preset--color--primary)}.artifact-newsletter-form input[type=email]{flex:1;min-width:0;background:transparent;border:0;color:var(--wp--preset--color--text-white);font-family:var(--wp--preset--font-family--poppins);font-size:var(--wp--preset--font-size--medium-paragraph);outline:0;padding:8px 8px 8px 0}.artifact-newsletter-form input[type=email]::placeholder{color:var(--wp--preset--color--text-color)}.artifact-newsletter-form button{width:48px;height:48px;background:var(--wp--preset--color--primary);border:0;border-radius:12px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0}.artifact-newsletter-form button:hover{background:var(--wp--preset--color--border)}hr.wp-block-separator{border-color:var(--wp--preset--color--border) !important;opacity:1 !important}",
		"color": {
			"background": "var(--wp--preset--color--main-bg)",
			"text": "var(--wp--preset--color--text-color)"
		},
		"spacing": {
			"blockGap": "20px",
			"padding": {
				"top": "0px",
				"right": "0px",
				"bottom": "0px",
				"left": "0px"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--poppins)",
			"fontSize": "var(--wp--preset--font-size--medium-paragraph)",
			"fontWeight": "400",
			"lineHeight": "28px"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--link-color)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				},
				":active": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				}
			},
			"button": {
				"color": {
					"text": "var(--wp--preset--color--text-white)",
					"background": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--text-white)",
						"background": "var(--wp--preset--color--light-bg)"
					}
				},
				"border": {
					"radius": "12px"
				},
				"spacing": {
					"padding": {
						"bottom": "16px",
						"left": "32px",
						"right": "32px",
						"top": "16px"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontSize": "var(--wp--preset--font-size--button-large)",
					"fontWeight": "600",
					"lineHeight": "20px"
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontSize": "var(--wp--preset--font-size--medium-title)",
					"fontWeight": "700"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-01)",
					"lineHeight": "1.06"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-02)",
					"lineHeight": "1.11"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-03)",
					"lineHeight": "1.2"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-04)",
					"lineHeight": "1.2"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-05)",
					"lineHeight": "1.2"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-06)",
					"lineHeight": "1.2"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--heading-color)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			}
		},
		"blocks": {
			"core/post-comments-form": {
				"css": "& textarea { background-color: var(--wp--preset--color--light-bg); color: var(--wp--preset--color--text-white); border: 1px solid var(--wp--preset--color--text-color); border-radius: 8px; padding: 12px 16px; } & input:not([type=submit]):not([type=checkbox]) { background-color: var(--wp--preset--color--light-bg); color: var(--wp--preset--color--text-white); border: 1px solid var(--wp--preset--color--text-color); border-radius: 8px; padding: 12px 16px; }"
			},
			"core/search": {
				"css": "& .wp-block-search__input { background-color: var(--wp--preset--color--light-bg); color: var(--wp--preset--color--text-white); border: 1px solid var(--wp--preset--color--text-color); padding: 12px 16px; }"
			},
			"core/navigation": {
				"spacing": {
					"blockGap": "32px"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--button-large)",
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontWeight": "600"
				},
				"color": {
					"text": "var(--wp--preset--color--link-color)"
				}
			}
		}
	}
}
