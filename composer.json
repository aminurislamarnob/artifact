{
	"name": "aminurislamarnob/artifact",
	"description": "Artifact, a black WordPress block theme for company websites. Development tooling only.",
	"type": "wordpress-theme",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-phpunit/wp-phpunit": "*"
	},
	"config": {
		"sort-packages": true
	},
	"scripts": {
		"test": [
			"@test:unit",
			"@test:integration"
		],
		"test:unit": "phpunit -c phpunit-unit.xml.dist",
		"test:integration": "phpunit --testsuite integration"
	}
}
